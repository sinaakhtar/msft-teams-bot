{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "<TEAMS_APP_GUID>",
  "developer": {
    "name": "Contoso Sandbox",
    "websiteUrl": "https://<BOT_DOMAIN>",
    "privacyUrl": "https://<BOT_DOMAIN>/privacy",
    "termsOfUseUrl": "https://<BOT_DOMAIN>/terms"
  },
  "name": {
    "short": "Agent Runtime Bot",
    "full": "Teams bot for the Google Agent Runtime agent"
  },
  "description": {
    "short": "Ask the ADK agent, authenticated as you.",
    "full": "Relays your messages to an ADK agent running on Google's Agent Runtime. Your Microsoft Entra identity is federated to a Google Cloud workforce principal, so every invocation is authorized and audited as you rather than as a shared service account. Personal chat only."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2C5F9E",
  "bots": [
    {
      "botId": "<APP_A_CLIENT_ID>",
      "scopes": [
        "personal"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": [
        {
          "scopes": [
            "personal"
          ],
          "commands": [
            {
              "title": "whoami",
              "description": "Show the identity the agent sees for you"
            }
          ]
        }
      ]
    }
  ],
  "webApplicationInfo": {
    "id": "<APP_A_CLIENT_ID>",
    "resource": "api://botid-<APP_A_CLIENT_ID>"
  },
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "<BOT_DOMAIN>"
  ]
}
