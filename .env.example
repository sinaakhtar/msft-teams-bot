# ===========================================================================
# .env.example -- the single source of every environment-specific value.
#
# Copy to `.env`, fill in, and never commit it (`.env` is gitignored).
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a && . ./.env && set +a
#
# Every angle-bracket placeholder in this repository corresponds to a variable
# below. To find every slot that still needs a value:
#
#     grep -rn '<[A-Z_]\+>' --exclude-dir=.venv --exclude-dir=.git .
#
# NOTHING in this file is a secret you can leave at its default. The two
# genuine secrets (MICROSOFT_APP_PASSWORD, ENTRA_CLIENT_SECRET) are read from
# Google Secret Manager in production and are ONLY read from here in local dev
# mode -- see middle_tier/app/config.py, which logs a CRITICAL line per secret
# read so that a dev-mode read in a deployed environment is alertable.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. GOOGLE CLOUD
# ---------------------------------------------------------------------------

# Project that holds the IAM bindings, APIs, secrets, BigQuery dataset and the
# Cloud Run middle tier.
#   gcloud projects list
GCP_PROJECT_ID=

# Numeric project number for the SAME project. Several APIs return or require
# the number rather than the ID; the Sessions API in particular echoes resource
# names using the number, so a mismatch here breaks session resolution.
#   gcloud projects describe "$GCP_PROJECT_ID" --format='value(projectNumber)'
GCP_PROJECT_NUMBER=

# Numeric organization ID. Workforce identity pools are ORG-level resources,
# so this is required even though everything else is project-scoped. Being
# project Owner is not enough to create the pool.
#   gcloud organizations list
GCP_ORG_ID=

# Region for regional resources. Agent Runtime (reasoning engines) and the
# Cloud Run middle tier both live here. `global` returns an empty engine list,
# so do not use it.
GCP_LOCATION=us-central1

# Used by agent/deploy.py, which reads the Vertex SDK's own variable names.
# Set these to the same values as GCP_PROJECT_ID / GCP_LOCATION above.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# GCS bucket for agent deployment staging. Defaults to
# gs://${GOOGLE_CLOUD_PROJECT}-agent-staging if left blank.
STAGING_BUCKET=


# ---------------------------------------------------------------------------
# 2. MICROSOFT ENTRA
#
# There are TWO app registrations and they are NOT interchangeable. Collapsing
# them is the single most common setup mistake. See docs/adr/002 and
# entra/README.md.
#
#   Bot app        -- authenticates the BOT to the Bot Framework.
#   Federation app -- authenticates the HUMAN to Google via OBO + STS.
# ---------------------------------------------------------------------------

# Entra tenant (directory) ID. Forms the OIDC issuer URI that the Google
# workforce pool provider trusts.
#   Entra admin center > Overview > Tenant ID
ENTRA_TENANT_ID=

# Your tenant's default domain, e.g. contoso.onmicrosoft.com. Used in docs and
# in the BigQuery seed data to label the demo users.
#   Entra admin center > Overview > Primary domain
TENANT_DOMAIN=

# Your tenant's short display name, e.g. "contoso". The Azure portal uses it in
# prose the runbooks quote back at you, such as the account-type radio button
# "Accounts in this organizational directory only (<TENANT_NAME> only)" and the
# "Granted for <TENANT_NAME>" consent status. Usually TENANT_DOMAIN minus the
# .onmicrosoft.com suffix.
TENANT_NAME=

# --- Bot app registration (entra/01_bot_app_registration.md) ---------------

# Application (client) ID of the Azure Bot registration. This is MICROSOFT_APP_ID
# as far as the middle tier is concerned, and `botId` in the Teams manifest.
BOT_APP_CLIENT_ID=
MICROSOFT_APP_ID=

# SingleTenant | MultiTenant | UserAssignedMSI.
# Azure stopped supporting NEW multi-tenant bot registrations after 2025-07-31.
MICROSOFT_APP_TYPE=SingleTenant

# --- Federation app registration (entra/02_federation_app_obo.md) ----------

# Application (client) ID of the app used to federate into Google STS. This is
# the value that appears as `aud` in the ID token the workforce pool accepts.
#
# NOTE: the codebase reads this under TWO names. middle_tier/app/config.py
# reads FEDERATION_APP_ID; the layer3 and spikes scripts read
# FEDERATION_APP_CLIENT_ID. Set BOTH to the same value. Unifying the name is a
# deliberate non-change here -- it would be a behaviour edit, not a
# sanitisation. See SANITISATION.md.
FEDERATION_APP_ID=
FEDERATION_APP_CLIENT_ID=


# ---------------------------------------------------------------------------
# 3. SECRETS
#
# In production these live in Google Secret Manager and the variables below are
# the SECRET NAMES, not the values. The raw *_PASSWORD / *_SECRET values are
# read from the environment ONLY when MIDDLE_TIER_DEV_MODE=true, which is
# refused on Cloud Run.
# ---------------------------------------------------------------------------

MICROSOFT_APP_PASSWORD_SECRET=teams-bot-app-password
ENTRA_CLIENT_SECRET_SECRET=entra-obo-client-secret

# Local development only. Leave EMPTY for any deployed environment.
MICROSOFT_APP_PASSWORD=
ENTRA_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# 4. WORKFORCE IDENTITY FEDERATION
#
# These are names this repo CHOOSES rather than identifiers your environment
# imposes, so the defaults are usable as-is. They are baked into both the STS
# audience and every IAM principalSet binding, so changing either one after
# the fact breaks federation and all role grants at once. Decide early.
# Defaults match terraform/variables.tf (pool_id, provider_id).
# ---------------------------------------------------------------------------

WORKFORCE_POOL_ID=teams-bot-demo
WORKFORCE_PROVIDER_ID=entra


# ---------------------------------------------------------------------------
# 5. AGENT RUNTIME
# ---------------------------------------------------------------------------

# Numeric ID of the reasoning engine YOU deployed with agent/deploy.py. Empty
# until you have deployed. The middle tier builds the full resource name from
# GCP_PROJECT_NUMBER + GCP_LOCATION + this.
#   python agent/deploy.py --list
REASONING_ENGINE_ID=

# Display name used when creating the engine.
AGENT_DISPLAY_NAME=teams-bot-bq-analyst

# Engines agent/deploy.py must REFUSE to delete, comma-separated bare numeric
# IDs. Empty means the guard is inert.
#
# If your project hosts ANY reasoning engine you did not deploy from this repo,
# list it here. `--rollback` takes a resource name that is one fat-finger away
# from somebody else's agent, and the failure is destructive.
#   python agent/deploy.py --list
PROTECTED_ENGINE_IDS=

# Contract between the middle tier and the agent: the runtime turns
# authorizations["<this>"] into session-state key temp:<this>, which is where
# the agent reads the per-user token from. Changing it is a breaking change on
# BOTH sides -- change it in both or neither.
RUNTIME_AUTHORIZATION_ID=bigquery_user
BQ_AGENT_AUTHORIZATION_ID=bigquery_user

# Billing/quota project for BigQuery calls made by the agent. Workforce
# principals have no project of their own, so BigQuery cannot infer one to bill
# and rejects the call without this. Normally the same as GCP_PROJECT_ID.
BQ_AGENT_USER_PROJECT=

BQ_AGENT_MODEL=gemini-3.5-flash
BQ_MCP_URL=https://bigquery.googleapis.com/mcp


# ---------------------------------------------------------------------------
# 6. BIGQUERY DEMO DATASET  (bigquery/apply.sh)
#
# The .sql files are TEMPLATES containing <ANGLE_BRACKET> placeholders. They
# are not directly runnable: apply.sh renders them into bigquery/.rendered/
# using the values below and runs the rendered copies.
# ---------------------------------------------------------------------------

BQ_DATASET=teams_bot_demo
BQ_AGENT_DATASET=teams_bot_demo

# Must match the dataset's location or bq fails with "Not found: Dataset",
# which actually means "wrong region".
BQ_LOCATION=US

# Entra object ID (oid, NOT the UPN) of the demo ANALYST user. This is the
# subject in the workforce principal URI and the key the row access policies
# match on.
#   az ad user show --id analyst@$TENANT_DOMAIN --query id -o tsv
ANALYST_OBJECT_ID=

# Entra object ID of the demo M365 ADMIN user, the other half of the two-user
# RLS split. apply.sh refuses to run without it unless ALLOW_PLACEHOLDER=1,
# because the failure mode is a demo that applies cleanly and then shows the
# admin zero rows on stage.
#   az ad user show --id m365-admin@$TENANT_DOMAIN --query id -o tsv
M365_ADMIN_OBJECT_ID=

# A first-party Google account granted a break-glass row access policy so the
# operator running apply.sh can still read the table. DEMO CONVENIENCE ONLY --
# delete that policy for anything holding real data (see 04_row_access_policies.sql).
# Defaults to your active gcloud account.
GOOGLE_ADMIN_ACCOUNT=

# Your Google Cloud org's primary domain, e.g. example.com. Used by the layer3
# concurrency spike to recognise a first-party account in SESSION_USER() output.
ORG_DOMAIN=


# ---------------------------------------------------------------------------
# 7. MIDDLE TIER RUNTIME
# ---------------------------------------------------------------------------

# Cloud Run contract: the service must listen on $PORT.
PORT=8080
LOG_LEVEL=INFO

# Enables the env-var fallback for secrets. Requires the absence of K_SERVICE,
# so setting it on Cloud Run raises at startup rather than degrading. Every
# secret read in this mode logs a CRITICAL line naming the secret.
MIDDLE_TIER_DEV_MODE=false

# Bot Framework Emulator support. Requires MIDDLE_TIER_DEV_MODE=true; setting
# it alone is a startup error. This relaxes inbound JWT validation, which is
# the entire authentication boundary of the service -- never set it in a
# deployed environment.
ALLOW_BOT_EMULATOR=false

# Optional. Shown to the user on an identity failure (ADR 004): the sign-in
# card target, and who to contact when signing in again does not help.
SIGNIN_URL=
SUPPORT_CONTACT=


# ---------------------------------------------------------------------------
# 8. AZURE BOT SERVICE AND CLOUD RUN  (runbook/11_azure_bot_service.md)
#
# Not read by any code -- these are filled in through the Azure and Google
# consoles. They are listed here so that every <PLACEHOLDER> in the runbook has
# exactly one documented home.
#
# NAMING: the Entra docs in entra/ and runbook/ call the two app registrations
# "App A" and "App B". They map to the variables above:
#     App A = the bot app        = BOT_APP_CLIENT_ID / MICROSOFT_APP_ID
#             its secret         = MICROSOFT_APP_PASSWORD  (<APP_A_CLIENT_SECRET>)
#     App B = the federation app = FEDERATION_APP_ID / FEDERATION_APP_CLIENT_ID
# ---------------------------------------------------------------------------

# Azure subscription and resource group that hold the Azure Bot resource.
AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=

# Globally unique handle for the Azure Bot resource.
BOT_HANDLE=

# Name of the Azure Bot OAuth Connection Setting, if you configure one.
OAUTH_CONNECTION_NAME=

# Cloud Run service name and the URL it is assigned after first deploy. The
# Azure Bot messaging endpoint is https://<CLOUD_RUN_URL>/api/messages, and
# BOT_DOMAIN below is the same host without the scheme.
CLOUD_RUN_SERVICE=teams-bot-middle-tier
CLOUD_RUN_URL=

# Alias for GCP_LOCATION. The entra/ docs write it as <REGION>.
REGION=us-central1


# ---------------------------------------------------------------------------
# 9. TEAMS APP MANIFEST  (entra/manifest/manifest.json)
#
# Not read by any code. The manifest is edited by hand before packaging; these
# are recorded here so every placeholder in the repo has one documented home.
# ---------------------------------------------------------------------------

# A GUID you generate for the Teams app itself. NOT either app registration ID.
#   python -c "import uuid; print(uuid.uuid4())"
TEAMS_APP_GUID=

# Hostname of the deployed middle tier, no scheme and no path. The Azure Bot
# messaging endpoint is https://<this>/api/messages.
BOT_DOMAIN=


# ===========================================================================
# APPENDIX: placeholders that are NOT configuration
#
# Not every <ANGLE_BRACKET> in this repo is a slot you fill in. The docs also
# use them to redact a value that was captured from a live run, or to show the
# SHAPE of something the system generates. Those have no entry above and you
# should not try to set them:
#
#   <SESSION_ID_1..3> <OPERATION_ID> <STREAM_ID> <SID> <OUR_ID>
#       identifiers minted by Agent Runtime at runtime.
#   <OTHER_ENGINE_ID_1..3> <ROLLED_BACK_ENGINE_ID>
#       reasoning engines that existed in the build environment and were NOT
#       part of this project. Redacted on purpose; see PROTECTED_ENGINE_IDS.
#   <ENTRA_OID> <TID> <OID> <USER_TOKEN> <TEAMS_SSO_TOKEN>
#       claim and token shapes in worked examples.
#   <REPO_ROOT> <SCRATCH_DIR>
#       wherever you cloned this, and a scratch directory from the original
#       build. Substitute mentally.
#   <OPERATOR_GOOGLE_ACCOUNT> <GCP_CUSTOMER_ID> <OTHER_ALLOWED_CUSTOMER_ID>
#       the identity and directory of whoever built this. Redacted.
#   <ANALYST_TOTAL> <ADMIN_TOTAL> <ADMIN_ONLY_DEAL_NAME> <PRINCIPAL_ADMIN>
#   <OBSERVED_SESSION_METHOD>
#       results you are meant to OBSERVE while running the demo script in
#       runbook/12_demo.md, deliberately left blank rather than asserted.
# ===========================================================================
